# Make a copy of this file and name it ".env.macos"
# Used for MacOS environments.
HOST_IP=$(ifconfig en0 | grep "inet " | cut -d ' ' -f 2)
# Use a fixed version instead of the latest one, e.g. apazga/docker-pgmodeler:1.2.3
PGMODELER_IMAGE=apazga/docker-pgmodeler:latest
# Folder that contains the "data" directory (defaults to the folder of the run script)
#PROJECT_ROOT=/Users/toto/docker-pgmodeler
